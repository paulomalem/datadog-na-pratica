{
  "title": "Lab Loja Datadog - Visão geral (v2)",
  "description": "Visão geral enriquecida: negócio (pedidos, conversão, SKUs), SRE (golden signals por serviço) e plataforma (banco, recursos, restarts).",
  "layout_type": "ordered",
  "reflow_type": "fixed",
  "template_variables": [
    {
      "name": "env",
      "prefix": "env",
      "defaults": [
        "dev"
      ],
      "available_values": []
    }
